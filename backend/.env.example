# Hedwig Backend — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
HOST=127.0.0.1
PORT=8080

# Database (Developer 2 will finalise the schema)
DATABASE_URL=mysql://hedwig_user:your_password_here@127.0.0.1:3306/hedwig

# Log level: trace | debug | info | warn | error
RUST_LOG=hedwig_backend=debug,tower_http=debug

# HMAC signing secret used by client applications.
# Must be a long random string. Keep it secret.
# HMAC_SECRET=replace_with_a_strong_random_secret

# Timestamp tolerance for HMAC replay protection (seconds).
# Requests older than this will be rejected.
HMAC_TIMESTAMP_TOLERANCE_SECS=300
